# 세션 쿠키와 데모 결과 파일 참조 서명에 쓰는 비밀키.
# 운영에서는 반드시 무작위 값으로 교체한다: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-random-32-byte-secret

# 관리자 단일 계정 (4단계에서 사용)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# ── 데이터 저장 위치 ───────────────────────────────────────────
# 비워 두면 data/*.json 파일에 저장한다 (개발·사내 서버).
#
# Vercel 은 배포 산출물이 읽기 전용이라 파일에 못 쓴다. Vercel 대시보드에서
# Storage → Blob 을 만들고 프로젝트에 연결하면 이 값이 자동으로 주입되며,
# 그때부터 관리자 저장이 Blob 으로 간다.
#
# 나중에 사내 서버로 옮길 때는 이 값을 빼면 그대로 파일 저장으로 돌아간다.
# BLOB_READ_WRITE_TOKEN=

# Blob 저장소의 공개 설정 (public | private).
# 비워 두면 한 번 시도해 보고 저장소가 알려 주는 대로 맞춘다. 못 박고 싶을 때만 쓴다.
# BLOB_ACCESS=private

# 구글 드라이브 영상 연결 (선택).
# 관리자가 드라이브 공유 링크를 붙여넣으면 이 키로 재생 주소를 만든다.
# Google Cloud Console 에서 Drive API 사용 설정 후 API 키 발급.
# 키가 리다이렉트 주소에 드러나므로 반드시 HTTP 리퍼러(사이트 도메인)로 제한할 것.
# GOOGLE_DRIVE_API_KEY=
